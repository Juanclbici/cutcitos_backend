{
  "compilerOptions": {
    "target": "es2022",
    "module": "Node16",                      /* El estándar nativo e infalible para backend Node */
    "moduleResolution": "nodenext",              /* Obliga a TS a mapear node_modules físicamente */
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,                           /* Mantiene la convivencia con tus archivos .js */
    "noEmit": true,
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["src/**/*", "tests/test-env.ts"],
  "exclude": ["node_modules"]
}