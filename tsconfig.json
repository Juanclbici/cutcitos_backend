{
  "compilerOptions": {
    "rootDir": "./src",
    "target": "es2022",
    "module": "nodenext",                   
    "moduleResolution": "nodenext",   
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,                           
    "noEmit": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}